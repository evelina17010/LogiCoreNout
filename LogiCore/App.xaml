<Application x:Class="LogiCore.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LogiCore"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <Style x:Key="Main" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontFamily" Value="Segoe U"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="Foreground" Value="SeaGreen"/>
        </Style>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="Fields" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#616161"/>
            <Setter Property="FontFamily" Value="Segoe U "/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Padding" Value="7"/>
            <Setter Property="Margin" Value="7 7 7 0"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Width" Value="500"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>

        <Style x:Key="Reg" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Justify"/>
            <Setter Property="Foreground" Value="Red"/>
            <Setter Property="FontFamily" Value="Segoe U "/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Margin" Value="4 4 4 0"/>
        </Style>

        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="Segoe U "/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Margin" Value="7 7 7 0"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Width" Value="500"/>
            <Setter Property="Foreground" Value="#707070"/>
        </Style>

        <Style x:Key="Name" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="Segoe U "/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Margin" Value="4 4 4 0"/>
            <Setter Property="Foreground" Value="#707070"/>
        </Style>

        <Style x:Key="Vhod" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="Red"/>
            <Setter Property="FontFamily" Value="Segoe U "/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Margin" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="7" BorderThickness="2" BorderBrush="Red" Width="450" Height="45">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Refresh" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="SeaGreen"/>
            <Setter Property="FontFamily" Value="Segoe U "/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Margin" Value="7"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="7" BorderThickness="2" BorderBrush="SeaGreen" Width="135" Height="45">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Action" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="Red"/>
            <Setter Property="FontFamily" Value="Segoe U "/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="7"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="7" BorderThickness="2" BorderBrush="Red" Width="90" Height="25">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Vhodbor" TargetType="Border">
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="Red"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="0 10 0 0"/>
        </Style>

        <Style x:Key="Regist" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="Red"/>
            <Setter Property="FontFamily" Value="Segoe U "/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="15"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="7" BorderThickness="2" BorderBrush="Red" Width="375" Height="50">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Border" TargetType="Border">
            <Setter Property="BorderThickness" Value="7"/>
            <Setter Property="BorderBrush" Value="#e2e9e9"/>
            <Setter Property="Background" Value="#e2e9e9"/>
        </Style>

        <Style x:Key="Role" TargetType="ComboBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="#707070"/>
            <Setter Property="FontFamily" Value="Segoe U "/>
            <Setter Property="Width" Value="500"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Margin" Value="7 7 7 0"/>
        </Style>

        <Style x:Key="Back" TargetType="TextBlock">
            <Setter Property="Height" Value="50"/>
            <Setter Property="Width" Value="90"/>
            <Setter Property="Foreground" Value="#707070"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="7 4 0 0"/>
            <Setter Property="FontFamily" Value="Segoe U "/>
            <Setter Property="FontSize" Value="30"/>
        </Style>

        <Style x:Key="BorderCenter" TargetType="Border">
            <Setter Property="Width" Value="600"/>
            <Setter Property="Height" Value="375"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#e2e9e9"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Padding" Value="2"/>
        </Style>

        <Style x:Key="Enbor" TargetType="Border">
            <Setter Property="Width" Value="600"/>
            <Setter Property="Height" Value="260"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#e2e9e9"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style x:Key="Rolebor" TargetType="Border">
            <Setter Property="Width" Value="450"/>
            <Setter Property="Height" Value="600"/>
            <Setter Property="Margin" Value="15"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="45 45 45 45"/>
        </Style>

        <Style x:Key="RoleborAdmin" TargetType="Border">
            <Setter Property="Width" Value="375"/>
            <Setter Property="Height" Value="600"/>
            <Setter Property="Margin" Value="15"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="45 45 45 45"/>
        </Style>

        <Style x:Key="clbtn" TargetType="Button">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="FontFamily" Value="Segoe U "/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Width" Value="225"/>
            <Setter Property="Height" Value="65"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="7" BorderThickness="2" BorderBrush="Black">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="UserName" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="Segoe U "/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Width" Value="375"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Margin" Value="4 4 4 0"/>
            <Setter Property="Foreground" Value="#707070"/>
        </Style>

        <Style x:Key="Clientrequest" TargetType="Border">
            <Setter Property="CornerRadius" Value="30"/>
            <Setter Property="Background" Value="#BCFAC4"/>
            <Setter Property="Height" Value="560"/>
            <Setter Property="Width" Value="710"/>
            <Setter Property="Margin" Value="15"/>
        </Style>

        <Style x:Key="Clientrequest1" TargetType="Border">
            <Setter Property="CornerRadius" Value="30"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Height" Value="525"/>
            <Setter Property="Width" Value="675"/>
            <Setter Property="Margin" Value="15"/>
        </Style>

        <Style x:Key="ClientStr" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Left"/>
            <Setter Property="Foreground" Value="#616161"/>
            <Setter Property="FontFamily" Value="Segoe U "/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Padding" Value="7"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Width" Value="450"/>
            <Setter Property="Margin" Value="4 4 4 0"/>
