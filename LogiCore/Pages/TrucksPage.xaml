<Page x:Class="LogiCore.Pages.TrucksPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:LogiCore.Pages"
      mc:Ignorable="d" 
d:DesignHeight="800" d:DesignWidth="1150" MaxHeight="1080" MaxWidth="1920" MinHeight="450" MinWidth="800"
      Title="Транспорт">
    <ScrollViewer>
        <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="5">
                <Button Content="Добавить" Click="AddTruck_Click" Style="{StaticResource Action}"/>
                <Button Content="Редактировать" Click="EditTruck_Click" Style="{StaticResource Action}"/>
                <Button Content="Удалить" Click="DeleteTruck_Click" Style="{StaticResource Action}"/>
                <Button Content="Обновить"  Click="Refresh_Click" Style="{StaticResource Action}"/>
                <Grid >
                    <TextBlock Text="Поиск по ID"  Style="{StaticResource Add}" Panel.ZIndex="1" Visibility="{Binding ElementName=TruckSearchTb,Path=Text.IsEmpty,Converter={StaticResource BoolToVis}}"/>
                    <TextBox  Style="{StaticResource Addtxb}"  Name="TruckSearchTb" TextChanged="TruckSearchTb_TextChanged"/>
                </Grid>
            </StackPanel>
            <DataGrid x:Name="TruckGrid" Grid.Row="1"  AutoGenerateColumns="False" SelectionChanged="TruckGrid_SelectionChanged"
 IsReadOnly="True" SelectionMode="Single" Style="{StaticResource dg}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Truck_id}" Width="Auto"/>
                    <DataGridTextColumn Header="Модель" Binding="{Binding Model}" Width="*"/>
                    <DataGridTextColumn Header="Рег. номер" Binding="{Binding Registration_number}" Width="*"/>
                    <DataGridTextColumn Header="Водитель" Binding="{Binding Driver.User.Full_name}" Width="*"/>
                    <DataGridTextColumn Header="Грузоподъемность (кг)" Binding="{Binding Capacity, StringFormat={}{0:N2}}" Width="*"/>
                    <DataGridCheckBoxColumn Header="Активен" Binding="{Binding Status_truck}" Width="Auto">
                        <DataGridCheckBoxColumn.ElementStyle>
                            <Style TargetType="CheckBox">
                                <Setter Property="IsEnabled" Value="False"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                            </Style>
                        </DataGridCheckBoxColumn.ElementStyle>
                    </DataGridCheckBoxColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
    </ScrollViewer>
</Page>
