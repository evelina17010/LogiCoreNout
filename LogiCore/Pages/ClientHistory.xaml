<Page x:Class="LC.Pages.ClientHistory"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:LogiCore.Pages"
      mc:Ignorable="d" 
     d:DesignHeight="450" d:DesignWidth="800" MaxHeight="1080" MaxWidth="1920" MinHeight="450" MinWidth="800"
      Title="История заказов">
    <Grid>
        
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10">
            <TextBlock Text="Мои Заказы" Style="{StaticResource Main}" FontSize="30"/>
            <ComboBox x:Name="cbFilter" Margin="20,0,0,0" Width="150" SelectedIndex="0" Height="50" Background="White"
                      SelectionChanged="cbFilter_SelectionChanged" Style="{StaticResource Role}" >
                <ComboBoxItem Content="Все" />
                <ComboBoxItem Content="В обработке"/>
                <ComboBoxItem Content="Завершен"/>
                <ComboBoxItem Content="Отменен"/>
                <ComboBoxItem Content="Новый" />
            </ComboBox>
            <Button x:Name="btnRefresh" Content="Обновить" Margin="20,0,0,0" Click="btnRefresh_Click" Style="{StaticResource Refresh}"/>
        </StackPanel>
        <ListView x:Name="lvOrders"    Grid.Row="1"  ItemsSource="{Binding orders}" Style="{StaticResource lv}" HorizontalAlignment="Left">
            <ListView.Resources>
                <Style TargetType="{x:Type GridViewColumnHeader}">
                    <Setter Property="Height" Value="45"/>
                    <Setter Property="FontSize" Value="15"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Background" Value="#BCFAC4"/>
                </Style>
            </ListView.Resources>
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Номер заказа" DisplayMemberBinding="{Binding Order_id}" Width="Auto"/>
                    <GridViewColumn Header="Дата заказа" DisplayMemberBinding="{Binding Order_date, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="Auto"/>
                    <GridViewColumn Header="Точка отправления" DisplayMemberBinding="{Binding Route.Start_point}" Width="Auto"/>
                    <GridViewColumn Header="Точка назначения" DisplayMemberBinding="{Binding Route.End_point}" Width="Auto"/>
                    <GridViewColumn Header="Статус" DisplayMemberBinding="{Binding Status_order}" Width="Auto"/>
                    <GridViewColumn Header="Стоимость" DisplayMemberBinding="{Binding Price, StringFormat={}{0:N2} руб.}" Width="Auto"/>
                    <GridViewColumn Header="Дата доставки" DisplayMemberBinding="{Binding Scheduled_delivery, StringFormat={}{0:dd.MM.yyyy}}" Width="Auto"/>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</Page>
