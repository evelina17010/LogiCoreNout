<Page x:Class="LogiCore.Pages.ClientPay"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:LogiCore.Pages"
      mc:Ignorable="d" 
   d:DesignHeight="800" d:DesignWidth="900" MaxHeight="1080" MaxWidth="1920" MinHeight="450" MinWidth="800"
      Title="История платежей">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10">
            <TextBlock Text="История платежей" Style="{StaticResource Main}"/>
            <Button Content="Обновить" Margin="20,0,0,0" 
                    Click="RefreshButton_Click" Style="{StaticResource Refresh}"/>
        </StackPanel>
        <ListView   ItemsSource="{Binding Payments}"  Grid.Row="1" Name="ListViewPayments" >
            <ListView.Resources>
                <Style TargetType="{x:Type GridViewColumnHeader}">
                    <Setter Property="Height" Value="45"/>
                    <Setter Property="FontSize" Value="20"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Background" Value="#BCFAC4"/>
                </Style>
            </ListView.Resources>
            <ListView.View>
                        <GridView>
                            <GridView.Columns>
                        <GridViewColumn Header="ID Платежа" Width="Auto">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                    <TextBlock Text="{Binding Payment_id}" Style="{StaticResource data}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                        <GridViewColumn Header="ID Заказа"  Width="Auto">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                    <TextBlock Text="{Binding Order_id}" Style="{StaticResource data}"/>
                                </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                        <GridViewColumn Header="Цена" Width="Auto">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                    <TextBlock Text="{Binding Amount}" Style="{StaticResource data}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                        <GridViewColumn Header="Статус"  Width="Auto">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Status_payment}" Style="{StaticResource data}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Дата оплаты" Width="Auto">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                    <TextBlock Text="{Binding Transaction_date,StringFormat='dd.MM.yyyy HH:mm:ss'}" Style="{StaticResource data}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView.Columns>
                        </GridView>
                    </ListView.View>
                </ListView>

    </Grid>
</Page>
