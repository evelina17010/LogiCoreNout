<Page x:Class="LogiCore.Pages.DriverSchedule"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:LogiCore.Pages"
      mc:Ignorable="d" 
          d:DesignHeight="800" d:DesignWidth="1150" MaxHeight="1080" MaxWidth="1920" MinHeight="450" MinWidth="800"
      Title="Расписание Водителя">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
            <DatePicker x:Name="DatePickerFrom" Width="150" Margin="0,0,10,0"/>
            <DatePicker x:Name="DatePickerTo" Width="150" Margin="0,0,10,0"/>
            <Button Content="Показать" Click="ShowSchedule_Click" Style="{StaticResource Action}" Width="150"/>
            <Button Content="Обновить" Click="RefreshSchedule_Click" Style="{StaticResource Action}" Margin="10,0,0,0" Width="150"/>
        </StackPanel>

        <DataGrid x:Name="ScheduleGrid" Grid.Row="1" AutoGenerateColumns="False"  SelectionMode="Single" IsReadOnly="True" Style="{StaticResource dg}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat=dd.MM.yyyy}" Width="*"/>
                <DataGridTextColumn Header="Маршрут" Binding="{Binding Route.Start_point}" Width="*"/>
                <DataGridTextColumn Header="Куда" Binding="{Binding Route.End_point}" Width="*"/>
                <DataGridTextColumn Header="Груз" Binding="{Binding Order.Cargo.Description}" Width="*"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="*"/>
                <DataGridTextColumn Header="Время" Binding="{Binding TimeSlot}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
