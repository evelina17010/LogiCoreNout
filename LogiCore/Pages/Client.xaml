<Page x:Class="LC.Pages.Client"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:LC.Pages"
      mc:Ignorable="d" 
 d:DesignHeight="1000" d:DesignWidth="1800" MaxHeight="1080" MaxWidth="1920" MinHeight="450" MinWidth="800"
      Title="Клиент"  Background="WhiteSmoke">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource Rolebor}" Grid.Column="0" Background="#BCFAC4">
            <StackPanel  VerticalAlignment="Center">
                <Image Source="\Image\people.ico" Height="150" Margin="10"/>
                <TextBlock x:Name="txbName" Text="{Binding Full_name}"  Style="{StaticResource UserName}"/>
                <Button x:Name="btnrequest" Content="Создать запрос" Click="btnrequest_Click" Style="{StaticResource clbtn}"/>
                <Button x:Name="btnhistory" Content="История заказов" Click="btnhistory_Click" Style="{StaticResource clbtn}"/>
                <Button x:Name="btnReting" Content="Платежи" Click="btnPay_Click" Style="{StaticResource clbtn}"/>
                <Button x:Name="btnexit" Content="Выход" Click="btnexit_Click" Style="{StaticResource clbtn}"/>
            </StackPanel>
        </Border>
        <Frame x:Name="frClient" Grid.Column="1" Height="800" Width="1100"/>
    </Grid>
</Page>
