<Page x:Class="LogiCore.Pages.TariffsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:LogiCore.Pages"
      mc:Ignorable="d" 
   d:DesignHeight="800" d:DesignWidth="1150" MaxHeight="1080" MaxWidth="1920" MinHeight="450" MinWidth="800"
      Title="Тарифы">
    <ScrollViewer>
        <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="5">
                <Button Content="Добавить" Click="AddTariff_Click" Style="{StaticResource Action}"/>
                <Button Content="Редактировать" Click="EditTariff_Click" Style="{StaticResource Action}"/>
                <Button Content="Удалить" Click="DeleteTariff_Click" Style="{StaticResource Action}"/>
                <Button Content="Обновить"  Click="Refresh_Click" Style="{StaticResource Action}"/>
                <Grid >
                    <TextBlock Text="Поиск по ID"  Style="{StaticResource Add}" Panel.ZIndex="1" Visibility="{Binding ElementName=TariffSearchTb,Path=Text.IsEmpty,Converter={StaticResource BoolToVis}}"/>
                    <TextBox  Style="{StaticResource Addtxb}"  Name="TariffSearchTb" TextChanged="TariffSearchTb_TextChanged"/>
                </Grid>
            </StackPanel>
            <DataGrid x:Name="TariffGrid" Grid.Row="1"  AutoGenerateColumns="False" SelectionChanged="TariffGrid_SelectionChanged"
       IsReadOnly="True" SelectionMode="Single" Style="{StaticResource dg}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Tariff_id}" Width="Auto"/>
                    <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="*"/>
                    <DataGridTextColumn Header="Цена за км" Binding="{Binding Cost_km, StringFormat={}{0:N2}}" Width="*"/>
                    <DataGridTextColumn Header="Цена за кг" Binding="{Binding Cost_kg, StringFormat={}{0:N2}}" Width="*"/>
                    <DataGridTextColumn Header="Цена за м³" Binding="{Binding Cost_m3, StringFormat={}{0:N2}}" Width="*"/>
                    <DataGridTextColumn Header="Доп. стоимость" Binding="{Binding AdditionalCost, StringFormat={}{0:N2}}" Width="*"/>
                    <DataGridTextColumn Header="Дата создания" Binding="{Binding Created_time, StringFormat={}{0:dd.MM.yyyy}}" Width="Auto"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
    </ScrollViewer>
</Page>
