<Page x:Class="LogiCore.Pages.PaymentPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:LogiCore.Pages"
      mc:Ignorable="d" 
     d:DesignHeight="800" d:DesignWidth="1150" MaxHeight="1080" MaxWidth="1920" MinHeight="450" MinWidth="800"
      Title="Платежи">
    <ScrollViewer>
        <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="5">
                <Button Content="Добавить" Click="AddPay_Click" Style="{StaticResource Action}"/>
                <Button Content="Редактировать" Click="EditPay_Click" Style="{StaticResource Action}"/>
                <Button Content="Удалить" Click="DeletePay_Click" Style="{StaticResource Action}"/>
                <Button Content="Обновить"  Click="Refresh_Click" Style="{StaticResource Action}"/>
                <Grid >
                    <TextBlock Text="Поиск по ID"  Style="{StaticResource Add}" Panel.ZIndex="1" Visibility="{Binding ElementName=PaySearchTb,Path=Text.IsEmpty,Converter={StaticResource BoolToVis}}"/>
                    <TextBox  Style="{StaticResource Addtxb}"  Name="PaySearchTb" TextChanged="PaySearchTb_TextChanged"/>
                </Grid>
            </StackPanel>
            <DataGrid x:Name="PayGrid" Grid.Row="1" Margin="5" AutoGenerateColumns="False" 
           IsReadOnly="True" SelectionMode="Single" SelectionChanged="PayGrid_SelectionChanged" Style="{StaticResource dg}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Payment_id}" Width="Auto"/>
                    <DataGridTextColumn Header="Номер заказа" Binding="{Binding Order.Order_id}" Width="*"/>
                    <DataGridTextColumn Header="Сумма" Binding="{Binding Amount, StringFormat={}{0:N2}}" Width="*"/>
                    <DataGridTextColumn Header="Статус" Binding="{Binding Status_payment}" Width="*"/>
                    <DataGridTextColumn Header="Дата платежа" Binding="{Binding Transaction_date, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="Auto"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
        </Grid>
    </ScrollViewer>
</Page>
