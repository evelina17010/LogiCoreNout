<Page x:Class="LogiCore.Pages.OrderPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:LogiCore.Pages"
      mc:Ignorable="d" 
   d:DesignHeight="800" d:DesignWidth="1150" MaxHeight="1080" MaxWidth="1920" MinHeight="450" MinWidth="800"
      Title="Заказы">
    <ScrollViewer>
        <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="5">
                <Button Content="Добавить" Click="AddOrder_Click" Style="{StaticResource Action}"/>
                <Button Content="Редактировать" Click="EditOrder_Click" Style="{StaticResource Action}"/>
                <Button Content="Удалить" Click="DeleteOrder_Click" Style="{StaticResource Action}"/>
                <Button Content="Обновить"  Click="Refresh_Click" Style="{StaticResource Action}"/>
                <Grid >
                    <TextBlock Text="Поиск по ID"  Style="{StaticResource Add}" Panel.ZIndex="1" Visibility="{Binding ElementName=OrderSearchTb,Path=Text.IsEmpty,Converter={StaticResource BoolToVis}}"/>
                    <TextBox  Style="{StaticResource Addtxb}"  Name="OrderSearchTb" TextChanged="OrderSearchTb_TextChanged"/>
                </Grid>
            </StackPanel>
            <DataGrid x:Name="OrdersGrid" Grid.Row="1" Margin="5" AutoGenerateColumns="False" 
                  IsReadOnly="True" SelectionMode="Single" SelectionChanged="OrdersGrid_SelectionChanged" Style="{StaticResource dg}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Order_id}" Width="Auto"/>
                    <DataGridTextColumn Header="Менеджер" Binding="{Binding User.Full_name}" Width="*"/>
                    <DataGridTextColumn Header="Груз"  Binding="{Binding Cargo.Description}" Width="*"/>
                    <DataGridTextColumn Header="Откуда" Binding="{Binding Route.Start_point}" Width="*"/>
                    <DataGridTextColumn Header="Куда" Binding="{Binding Route.End_point}" Width="*"/>
                    <DataGridTextColumn Header="Грузовик" Binding="{Binding Truck.Model}" Width="*"/>
                    <DataGridTextColumn Header="Статус" Binding="{Binding Status_order}" Width="*"/>
                    <DataGridTextColumn Header="Дата заказа" Binding="{Binding Order_date, StringFormat={}{0:dd.MM.yyyy}}" Width="Auto"/>
                    <DataGridTextColumn Header="Цена" Binding="{Binding Price, StringFormat={}{0:N2}}" Width="Auto"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
        </Grid>
    </ScrollViewer>
</Page>
