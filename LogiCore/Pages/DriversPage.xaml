<Page x:Class="LogiCore.Pages.DriversPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:LogiCore.Pages"
      mc:Ignorable="d" 
     d:DesignHeight="800" d:DesignWidth="1150" MaxHeight="1080" MaxWidth="1920" MinHeight="450" MinWidth="800"
      Title="Водители">
    <ScrollViewer>
        <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="5">
            <Button Content="Добавить" Click="AddDriver_Click" Style="{StaticResource Action}"/>
            <Button Content="Редактировать" Click="EditDriver_Click" Style="{StaticResource Action}"/>
            <Button Content="Удалить" Click="DeleteDriver_Click" Style="{StaticResource Action}"/>
            <Button Content="Обновить"  Click="Refresh_Click" Style="{StaticResource Action}"/>
            <Grid >
                <TextBlock Text="Поиск по ID"  Style="{StaticResource Add}" Panel.ZIndex="1" Visibility="{Binding ElementName=DriverSearchTb,Path=Text.IsEmpty,Converter={StaticResource BoolToVis}}"/>
                <TextBox  Style="{StaticResource Addtxb}"  Name="DriverSearchTb" TextChanged="DriverSearchTb_TextChanged"/>
            </Grid>
        </StackPanel>
        <DataGrid x:Name="DriversGrid" Grid.Row="1" Margin="5" AutoGenerateColumns="False" SelectionChanged="DriversGrid_SelectionChanged"
                  IsReadOnly="True" SelectionMode="Single" Style="{StaticResource dg}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Driver_id}" Width="Auto"/>
                <DataGridTextColumn Header="ID пользователя" Binding="{Binding User_id}" Width="Auto"/>
                <DataGridTextColumn Header="ФИО" Binding="{Binding User.Full_name}" Width="*"/>
                <DataGridTextColumn Header="Номер лицензии" Binding="{Binding License_number}" Width="*"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding Status_driver}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
    </ScrollViewer>
</Page>
