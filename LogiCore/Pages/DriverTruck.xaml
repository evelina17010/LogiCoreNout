<Page x:Class="LogiCore.Pages.DriverTruck"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:LogiCore.Pages"
      mc:Ignorable="d" 
  d:DesignHeight="800" d:DesignWidth="1150" MaxHeight="1080" MaxWidth="1920" MinHeight="450" MinWidth="800" Background="WhiteSmoke"
      Title="Транспорт Водителя">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Информация о моем грузовике" 
                   FontSize="30" FontWeight="Bold" Margin="20" Foreground="Red"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Модель:" Margin="0,5" FontWeight="Bold" Style="{StaticResource Text}"  FontSize="25"/>
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Model}" Margin="5,5" Style="{StaticResource Text}" FontSize="25"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Регистрационный номер:" Margin="0,5" FontWeight="Bold" Style="{StaticResource Text}" FontSize="25"/>
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Registration_number}" Margin="5,5" Style="{StaticResource Text}" FontSize="25"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Грузоподъемность:" Margin="0,5" FontWeight="Bold" Style="{StaticResource Text}" FontSize="25"/>
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Capacity}" Margin="5,5" Style="{StaticResource Text}" FontSize="25"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Размеры:" Margin="0,5" FontWeight="Bold" Style="{StaticResource Text}" FontSize="25"/>
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Dimensions}" Margin="5,5" Style="{StaticResource Text}" FontSize="25"/>

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Статус:" Margin="0,5" FontWeight="Bold" Style="{StaticResource Text}" FontSize="25"/>
            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Status_truck}" Margin="5,5" Style="{StaticResource Text}" FontSize="25"/>
        </Grid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Обновить данные" Click="RefreshData_Click" Margin="20"  Style="{StaticResource refresh}" />
        </StackPanel>
    </Grid>
</Page>
