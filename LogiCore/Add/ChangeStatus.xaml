<Window x:Class="LogiCore.Add.ChangeStatus"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LogiCore.Add"
        mc:Ignorable="d"
        Title="Смена статуса" Height="300" Width="600">
    <Border Style="{StaticResource WindowBackground}">
        <Grid Margin="10">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <GroupBox Grid.Row="0" Header="Информация о заказе" >
                <StackPanel >
                    <TextBlock Text="{Binding CurrentStatus, StringFormat='Текущий статус: {0}'}"  FontWeight="Bold" Margin="5"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Grid.Row="1" Header="Новый статус" Margin="0 10">
                <ComboBox ItemsSource="{Binding StatusOptions}"
                      SelectedItem="{Binding SelectedStatus}"
                      DisplayMemberPath="."
                      Margin="10"
                      Style="{StaticResource AddRole}"/>
            </GroupBox>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 10 0 0">
                <Button Content="Сохранить" Width="145" Margin="5" 
                    Click="Save_Click" IsDefault="True" Style="{StaticResource Action}"/>
                <Button Content="Отмена" Width="145" Margin="5" 
                    Click="Cancel_Click" IsCancel="True" Style="{StaticResource Action}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>

