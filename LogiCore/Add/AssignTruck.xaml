<Window x:Class="LogiCore.Add.AssignTruck"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LogiCore.Add"
        mc:Ignorable="d"
        Title="Выбор Транспорта" Height="450" Width="800">
    <Border Style="{StaticResource WindowBackground}">
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <GroupBox Grid.Row="0" Header="Информация о заказе" Padding="10">
                <StackPanel>
                    <TextBlock Text="{Binding Order_id, StringFormat='Заказ № {0}'}" FontWeight="Bold"/>
                    <TextBlock Text="{Binding User.Full_name, StringFormat='Клиент: {0}'}"/>
                    <TextBlock Text="{Binding Cargo.Description, StringFormat='Груз: {0}'}"/>
                    <TextBlock Text="{Binding Cargo.Weight, StringFormat='Вес: {0}'}"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Route.Start_point, StringFormat='Откуда: {0}'}" Margin="0 0 20 0"/>
                        <TextBlock Text="{Binding Route.End_point, StringFormat='Куда: {0}'}"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>
            <GroupBox Grid.Row="1" Header="Параметры подбора" Padding="10" Margin="0 10">
                <StackPanel Orientation="Horizontal">
                    <CheckBox Content="Только доступный транспорт" x:Name="OnlyAvailableCheckBox"
                         IsChecked="{Binding OnlyAvailable,UpdateSourceTrigger=PropertyChanged}"
                         Margin="0 0 20 0" VerticalAlignment="Center"/>
                    <TextBlock Text="Минимальная грузоподъемность:" VerticalAlignment="Center"/>
                    <TextBox Name="MinCapacityTextBox" Text="{Binding MinCapacity,UpdateSourceTrigger=PropertyChanged}" Width="150" Margin="5 0" Style="{StaticResource Addtxb}"/>
                    <TextBlock Text="кг" VerticalAlignment="Center" Margin="0 0 20 0"/>
                    <Button Content="Подобрать" Click="FilterTrucks_Click" Padding="10 3" Style="{StaticResource Action}"/>
                </StackPanel>
            </GroupBox>
            <DataGrid Grid.Row="2" ItemsSource="{Binding FilteredTrucks}"
                 AutoGenerateColumns="False" SelectionMode="Single"
                 SelectedItem="{Binding SelectedTruck}" x:Name="TrucksDataGrid">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Модель" Binding="{Binding Model}" Width="*"/>
                    <DataGridTextColumn Header="Рег.номер" Binding="{Binding Registration_number}" Width="*"/>
                    <DataGridTextColumn Header="Грузоподъемность" Binding="{Binding Capacity, StringFormat={}{0} кг}" Width="*"/>
                    <DataGridTextColumn Header="Водитель" Binding="{Binding Driver.User.Full_name}" Width="*"/>
                    <DataGridCheckBoxColumn Header="Доступен" Binding="{Binding Status_truck}" Width="Auto"/>
                </DataGrid.Columns>
            </DataGrid>
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 10">
                <Button Content="Назначить" Width="120" Height="30" 
                   Click="Assign_Click" IsDefault="True"
                   IsEnabled="{Binding SelectedTruck}" Style="{StaticResource Action}"/>
                <Button Content="Отмена" Width="120" Height="30" 
                   Margin="10 0 0 0" Click="Cancel_Click" IsCancel="True" Style="{StaticResource Action}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
