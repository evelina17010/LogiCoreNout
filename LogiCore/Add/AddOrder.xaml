<Window x:Class="LogiCore.Add.AddOrder"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LogiCore.Add"
        mc:Ignorable="d"
        Title="Добавление Заказа" Height="450" Width="800">
    <Border Style="{StaticResource WindowBackground}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>

            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <TextBlock Text="Менеджер" Name="managertxb" Style="{StaticResource Add}" Margin="5" Width="300" Height="40" HorizontalAlignment="Center" Panel.ZIndex="1" Visibility="{Binding ElementName=Managercb,Path=Text.IsEmpty,Converter={StaticResource BoolToVis}}"  />
                <ComboBox Name="Managercb"  Width="300" Height="40" Grid.ColumnSpan="2" VerticalAlignment="Center" Foreground="#707070"  HorizontalAlignment="Center" ItemsSource="{Binding Managers}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Full_name}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>
            <Grid Grid.Row="1">
                <TextBlock Text="Груз" Name="cargotxb" Style="{StaticResource Add}" Margin="5" Width="300" Height="40" HorizontalAlignment="Center" Panel.ZIndex="1" Visibility="{Binding ElementName=Cargocb,Path=Text.IsEmpty,Converter={StaticResource BoolToVis}}"  />
                <ComboBox Name="Cargocb"  Width="300" Height="40" Grid.ColumnSpan="2" VerticalAlignment="Center" Foreground="#707070" HorizontalAlignment="Center" ItemsSource="{Binding Cargos}" >
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Cargo_id}"/>
                                <TextBlock Text="{Binding Description}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>
            <Grid Grid.Row="2">
                <TextBlock Text="Taриф" Name="tarifftxb" Style="{StaticResource Add}" Margin="5" Width="300" Height="40" HorizontalAlignment="Center" Panel.ZIndex="1" Visibility="{Binding ElementName=Tariffcb,Path=Text.IsEmpty,Converter={StaticResource BoolToVis}}"  />
                <ComboBox Name="Tariffcb"  Width="300" Height="40" Grid.ColumnSpan="2" VerticalAlignment="Center" Foreground="#707070"  HorizontalAlignment="Center" ItemsSource="{Binding Tariffs}" >
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Cargo_id}"/>
                                <TextBlock Text="{Binding Description}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>
            <Grid Grid.Row="3">
                <TextBlock Text="Грузовик" Name="trucktxb" Style="{StaticResource Add}" Margin="5" Width="300" Height="40" HorizontalAlignment="Center" Panel.ZIndex="1" Visibility="{Binding ElementName=Truckcb,Path=Text.IsEmpty,Converter={StaticResource BoolToVis}}"  />
                <ComboBox Name="Truckcb"  Width="300" Height="40" Grid.ColumnSpan="2" VerticalAlignment="Center" Foreground="#707070" HorizontalAlignment="Center" ItemsSource="{Binding Trucks}" >
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Model}"/>
                                <TextBlock Text="{Binding Capacity}"/>
                                <TextBlock Text="{Binding Dimensions}"/>
                                <TextBlock Text="{Binding Location}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>
            <Grid Grid.Row="4">
                <TextBlock Text="Маршрут" Name="routetxb" Style="{StaticResource Add}"  Margin="5" Width="300" Height="40" HorizontalAlignment="Center" Panel.ZIndex="1" Visibility="{Binding ElementName=Routecb,Path=Text.IsEmpty,Converter={StaticResource BoolToVis}}"  />
                <ComboBox Name="Routecb"  Width="300" Height="40" Grid.ColumnSpan="2" VerticalAlignment="Center" Foreground="#707070" HorizontalAlignment="Center" ItemsSource="{Binding Routes}" >
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Start_point}"/>
                                <TextBlock Text="{Binding End_point}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>
            <Grid Grid.Row="5">
                <TextBlock Text="Стaтус" Name="statustxb" Style="{StaticResource Add}" Margin="5" Width="300" Height="40" HorizontalAlignment="Center" Panel.ZIndex="1" Visibility="{Binding ElementName=Statuscb,Path=Text.IsEmpty,Converter={StaticResource BoolToVis}}"  />
                <ComboBox Name="Statuscb"  Width="300" Height="40" Grid.ColumnSpan="2" VerticalAlignment="Center" Foreground="#707070" HorizontalAlignment="Center" SelectedValuePath="Content" >
                    <ComboBoxItem Content="Новый"/>
                    <ComboBoxItem Content="В обработке"/>
                    <ComboBoxItem Content="В пути"/>
                    <ComboBoxItem Content="Доставлен"/>
                    <ComboBoxItem Content="Отменен"/>
                </ComboBox>
            </Grid>
            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Сохранить" Width="300" Margin="5" Click="Save_Click" Style="{StaticResource ActionAdd}"/>
                <Button Content="Отменить" Style="{StaticResource ActionAdd}" Click="Cancel_Click" Width="320" Margin="5"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
