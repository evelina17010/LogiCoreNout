<Window x:Class="LogiCore.Add.AddPayment"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LogiCore.Add"
        mc:Ignorable="d"
        Title="Добавление Платежа" Height="450" Width="800">
    <Border Style="{StaticResource WindowBackground}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="1">
                <TextBlock Text="Заказ" Name="ordertxb" Style="{StaticResource Add}" Margin="5" Width="300" Height="40" HorizontalAlignment="Center" Panel.ZIndex="1" Visibility="{Binding ElementName=Ordercb,Path=Text.IsEmpty,Converter={StaticResource BoolToVis}}"  />
                <ComboBox Name="Ordercb"  Width="300" Height="40" Grid.ColumnSpan="2" VerticalAlignment="Center" Foreground="#707070"  HorizontalAlignment="Center" ItemsSource="{Binding orders}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Order_id}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>
            <Grid Grid.Row="2">
                <TextBlock Text="Сумма"  Style="{StaticResource Add}" Panel.ZIndex="1" Visibility="{Binding ElementName=txbSumm,Path=Text.IsEmpty,Converter={StaticResource BoolToVis}}"/>
                <TextBox x:Name="txbSumm" Style="{StaticResource Addtxb}"/>
            </Grid>
            <Grid Grid.Row="3">
                <TextBlock Text="Статус" Name="statustxb" Style="{StaticResource Add}" Margin="5" Width="300" Height="40" HorizontalAlignment="Center" Panel.ZIndex="1" Visibility="{Binding ElementName=Statuscb,Path=Text.IsEmpty,Converter={StaticResource BoolToVis}}"  />
                <ComboBox Name="Statuscb"  Width="300" Height="40" Grid.ColumnSpan="2" VerticalAlignment="Center" Foreground="#707070"  HorizontalAlignment="Center">
                    <ComboBoxItem Content="Ожидает оплаты"/>
                    <ComboBoxItem Content="Оплачен"/>
                    <ComboBoxItem Content="Отменен"/>
                </ComboBox>
            </Grid>
            <StackPanel Orientation="Horizontal" Grid.Row="6">
                <Button Content="Сохранить" Width="380" Margin="5" Click="Save_Click" Style="{StaticResource ActionAdd}"/>
                <Button Content="Отменить" Style="{StaticResource ActionAdd}" Click="Cancel_Click" Width="327" Margin="5"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
