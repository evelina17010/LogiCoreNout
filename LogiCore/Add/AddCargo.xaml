<Window x:Class="LogiCore.Add.AddCargo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LogiCore.Add"
        mc:Ignorable="d"
          Title="Добавление Груза" Height="450" Width="800">
    <Border Style="{StaticResource WindowBackground}">
        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="90"/>
            </Grid.RowDefinitions>
            <TextBlock Text="ФИО Клиента"  Style="{StaticResource Add}" Panel.ZIndex="1" Visibility="{Binding ElementName=txbFrom,Path=Text.IsEmpty,Converter={StaticResource BoolToVis}}" Grid.Row="6" />
            <ComboBox Name="Sotr"  Grid.Row="6" Style="{StaticResource AddRole}" VerticalAlignment="Center"  HorizontalAlignment="Center" ItemsSource="{Binding users}" >
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Full_name}" Style="{StaticResource Roleadd}"/>
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Text="Откуда"  Style="{StaticResource Add}" Panel.ZIndex="1" Visibility="{Binding ElementName=txbFrom,Path=Text.IsEmpty,Converter={StaticResource BoolToVis}}" Grid.Row="1" />
            <TextBox x:Name="txbFrom" Style="{StaticResource Addtxb}" Grid.Row="1" />
            <TextBlock Text="Куда"  Style="{StaticResource Add}" Panel.ZIndex="1" Visibility="{Binding ElementName=txbTo,Path=Text.IsEmpty,Converter={StaticResource BoolToVis}}" Grid.Row="2" />
            <TextBox x:Name="txbTo" Style="{StaticResource Addtxb}" Grid.Row="2" />
            <TextBlock Text="Масса(кг)"  Style="{StaticResource Add}" Panel.ZIndex="1" Visibility="{Binding ElementName=txbweight,Path=Text.IsEmpty,Converter={StaticResource BoolToVis}}" Grid.Row="3" />
            <TextBox x:Name="txbweight" Style="{StaticResource Addtxb}" Grid.Row="3" />
            <TextBlock Text="Объём"  Style="{StaticResource Add}" Panel.ZIndex="1" Visibility="{Binding ElementName=txbvolume,Path=Text.IsEmpty,Converter={StaticResource BoolToVis}}" Grid.Row="4" />
            <TextBox x:Name="txbvolume" Style="{StaticResource Addtxb}" Grid.Row="4" />
            <TextBlock Text="Описание(Тип груза)"  Style="{StaticResource Add}" Panel.ZIndex="1" Visibility="{Binding ElementName=txbdescription,Path=Text.IsEmpty,Converter={StaticResource BoolToVis}}" Grid.Row="0" />
            <TextBox x:Name="txbdescription" Style="{StaticResource Addtxb}" Grid.Row="0" />
            <DatePicker Grid.Row="5" Name="dpcargo" Style="{StaticResource ClnDt}" Height="40" Width="300" FontSize="20"/>
            <StackPanel Grid.Row="7"  Orientation="Horizontal" HorizontalAlignment="Center">
                <Button  Style="{StaticResource Action}" Content="Отменить" Click="Buttoncancel_Click" />
                <Button   Style="{StaticResource  Action}" Content="Сохранить" Click="ButtonCargo_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
