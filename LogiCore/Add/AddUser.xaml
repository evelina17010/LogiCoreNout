<Window x:Class="LogiCore.Add.AddUser"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LogiCore.Add"
        mc:Ignorable="d"
        Title="Добавить Пользователя" Height="450" Width="800">
    <Border Style="{StaticResource WindowBackground}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="1">
                <TextBlock Text="Full Name"  Style="{StaticResource Add}" Panel.ZIndex="1" Visibility="{Binding ElementName=txbName,Path=Text.IsEmpty,Converter={StaticResource BoolToVis}}" />
                <TextBox x:Name="txbName" Style="{StaticResource Addtxb}"/>
            </Grid>
            <Grid Grid.Row="2">
                <TextBlock Text="Phone Number"  Style="{StaticResource Add}" Panel.ZIndex="1" Visibility="{Binding ElementName=txbNumber,Path=Text.IsEmpty,Converter={StaticResource BoolToVis}}"/>
                <TextBox x:Name="txbNumber" Style="{StaticResource Addtxb}"/>
            </Grid>
            <Grid Grid.Row="3">
                <TextBlock Text="Email"  Style="{StaticResource Add}" Panel.ZIndex="1" Visibility="{Binding ElementName=txbEmail,Path=Text.IsEmpty,Converter={StaticResource BoolToVis}}"/>
                <TextBox x:Name="txbEmail" Style="{StaticResource Addtxb}"/>
            </Grid>
            <Grid Grid.Row="4">
                <TextBlock Text="Password" Style="{StaticResource Add}" Panel.ZIndex="1" Visibility="{Binding ElementName=txbPassword,Path=Text.IsEmpty,Converter={StaticResource BoolToVis}}"/>
                <TextBox x:Name="txbPassword" Style="{StaticResource Addtxb}"/>
            </Grid>
            <Grid Grid.Row="5">
                <TextBlock Text="Role" Style="{StaticResource Add}" Panel.ZIndex="1" Visibility="{Binding ElementName=CmbRole,Path=Text.IsEmpty,Converter={StaticResource BoolToVis}}" RenderTransformOrigin="0.518,0.608"/>
                <ComboBox x:Name="CmbRole" Style="{StaticResource AddRole}" ItemsSource="{Binding Roles}" >
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" Style="{StaticResource Roleadd}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>
            <StackPanel Orientation="Horizontal" Grid.Row="6"  Grid.RowSpan="2">
                <Button x:Name="btnReg" Style="{StaticResource ActionAdd}"  Content="Сохранить" Click="btnReg_Click" Width="362" Margin="5"/>
                <Button Content="Отменить" Style="{StaticResource ActionAdd}" Click="Cancel_Click" Width="327" Margin="5"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
