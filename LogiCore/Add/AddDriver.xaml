<Window x:Class="LogiCore.Add.AddDriver"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LogiCore.Add"
        mc:Ignorable="d"
        Title="Добавление Водителя" Height="450" Width="800">
    <Border Style="{StaticResource WindowBackground}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="1">
                <TextBlock Text="ФИО"  Style="{StaticResource Add}" Panel.ZIndex="1" Visibility="{Binding ElementName=txbName,Path=Text.IsEmpty,Converter={StaticResource BoolToVis}}"/>
                <TextBox x:Name="txbName" Style="{StaticResource Addtxb}"/>
            </Grid>
            <Grid Grid.Row="2">
                <TextBlock Text="Номер телефона"  Style="{StaticResource Add}" Panel.ZIndex="1" Visibility="{Binding ElementName=txbNumber,Path=Text.IsEmpty,Converter={StaticResource BoolToVis}}"/>
                <TextBox x:Name="txbNumber" Style="{StaticResource Addtxb}"/>
            </Grid>
            <Grid Grid.Row="3">
                <TextBlock Text="Email"  Style="{StaticResource Add}" Panel.ZIndex="1" Visibility="{Binding ElementName=txbEmail,Path=Text.IsEmpty,Converter={StaticResource BoolToVis}}"/>
                <TextBox x:Name="txbEmail" Style="{StaticResource Addtxb}"/>
            </Grid>
            <Grid Grid.Row="4">
                <TextBlock Text="Номер прав" Style="{StaticResource Add}" Panel.ZIndex="1" Visibility="{Binding ElementName=txtLicenseNumber,Path=Text.IsEmpty,Converter={StaticResource BoolToVis}}"/>
                <TextBox x:Name="txtLicenseNumber" Style="{StaticResource Addtxb}"/>
            </Grid>
            <Grid Grid.Row="5">
                <TextBlock Text="Статус" Style="{StaticResource Add}" Panel.ZIndex="1" Visibility="{Binding ElementName=cmbStatus,Path=Text.IsEmpty,Converter={StaticResource BoolToVis}}" Margin="0,14,0,0" VerticalAlignment="Top" Width="280" />
                <ComboBox x:Name="cmbStatus" Margin="250,6,250,4" Style="{StaticResource AddRole}" Width="250">
                    <ComboBoxItem Content="доступно"/>
                    <ComboBoxItem Content="не доступно"/>
                    <ComboBoxItem Content="на маршруте"/>
                </ComboBox>
            </Grid>
            <StackPanel Orientation="Horizontal"  Grid.Row="6">
                <Button Content="Сохранить" Style="{StaticResource ActionAdd}" Click="Save_Click" Width="395" Margin="5"/>
                <Button Content="Отменить" Style="{StaticResource ActionAdd}" Click="Cancel_Click" Width="327" Margin="5"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
