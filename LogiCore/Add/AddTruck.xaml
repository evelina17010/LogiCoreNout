<Window x:Class="LogiCore.Add.AddTruck"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LogiCore.Add"
        mc:Ignorable="d"
        Title="Добавление Транспорта" Height="450" Width="800">
    <Border Style="{StaticResource WindowBackground}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <TextBlock Text="Модель"  Style="{StaticResource Add}" Panel.ZIndex="1" Visibility="{Binding ElementName=txtModel,Path=Text.IsEmpty,Converter={StaticResource BoolToVis}}"/>
                <TextBox x:Name="txtModel" Style="{StaticResource Addtxb}"/>
            </Grid>
            <Grid Grid.Row="1">
                <TextBlock Text="Регистрационный номер"  Style="{StaticResource Add}" Panel.ZIndex="1" Visibility="{Binding ElementName=txtRegNumber,Path=Text.IsEmpty,Converter={StaticResource BoolToVis}}"/>
                <TextBox x:Name="txtRegNumber" Style="{StaticResource Addtxb}"/>
            </Grid>

            <Grid Grid.Row="2">
                <TextBlock Text="Водитель" Name="ordertxb" Style="{StaticResource Add}" Margin="5" Width="300" Height="40" HorizontalAlignment="Center" Panel.ZIndex="1" Visibility="{Binding ElementName=cmbDriver,Path=Text.IsEmpty,Converter={StaticResource BoolToVis}}"  />
                <ComboBox Name="cmbDriver" Width="300" Foreground="#707070" Height="40" ItemsSource="{Binding Drivers}" DisplayMemberPath="Full_name"  SelectedValuePath="User_id"  SelectedValue="{Binding Truck.Driver_id, Mode=TwoWay}"
              HorizontalAlignment="Center"/>
            </Grid>
            <Grid Grid.Row="3">
                <TextBlock Text="Грузоподъемность (кг)"  Style="{StaticResource Add}" Panel.ZIndex="1" Visibility="{Binding ElementName=txtCapacity,Path=Text.IsEmpty,Converter={StaticResource BoolToVis}}"/>
                <TextBox x:Name="txtCapacity" Style="{StaticResource Addtxb}"/>
            </Grid>
            <Grid Grid.Row="4">
                <TextBlock Text="Габариты"  Style="{StaticResource Add}" Panel.ZIndex="1" Visibility="{Binding ElementName=txtDimensions,Path=Text.IsEmpty,Converter={StaticResource BoolToVis}}"/>
                <TextBox x:Name="txtDimensions" Style="{StaticResource Addtxb}"/>
            </Grid>
            <Grid Grid.Row="5">
                <TextBlock Text="Местоположение"  Style="{StaticResource Add}" Panel.ZIndex="1" Visibility="{Binding ElementName=txtLocation,Path=Text.IsEmpty,Converter={StaticResource BoolToVis}}"/>
                <TextBox x:Name="txtLocation" Style="{StaticResource Addtxb}"/>
            </Grid>
            <CheckBox x:Name="chkStatus" Content="Активен" Grid.Row="6" Margin="0,0,0,10" Foreground="#707070" FontSize="20" HorizontalAlignment="Center"/>
            <StackPanel Orientation="Horizontal " Grid.Row="7">
                <Button Content="Сохранить" Width="364" Margin="5" Click="Save_Click" Style="{StaticResource ActionAdd}" />
                <Button Content="Отменить" Style="{StaticResource ActionAdd}" Margin="5" Click="Cancel_Click" Width="362" Height="42"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
